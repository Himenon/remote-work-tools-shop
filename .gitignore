# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.vitest-attachments

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
packages/database/generated/
packages/database/prisma/*.db
packages/database/prisma/*.db-journal

lefthook-local.yml

*storybook.log
storybook-static

*.log

# MCP browser screenshots (Playwright等での動作確認用)
/.screenshots/*
!/.screenshots/.gitkeep

.playwright-mcp
.screenshots
