{
  "name": "remote-work-tools-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rwts/web dev",
    "build": "pnpm --filter @rwts/database build && pnpm --filter @rwts/web build",
    "start": "pnpm --filter @rwts/web start",
    "check": "oxlint && oxfmt --check",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "pnpm run -r test",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "^6.11.0",
    "lefthook": "2.1.6",
    "oxfmt": "0.45.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.17.1"
  },
  "packageManager": "pnpm@10.17.1"
}
